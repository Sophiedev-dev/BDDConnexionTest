# Modèle de configuration : copiez ce fichier en ".env" (non versionné) et renseignez vos valeurs.
# Ne mettez JAMAIS de vraies valeurs dans ce fichier-ci.

# Compte GitHub personnel : utilisé UNIQUEMENT pour le scénario « identifiants valides ».
GITHUB_USERNAME=
GITHUB_PASSWORD=

# Compte GitHub de TEST, distinct du compte personnel : reçoit un mot de passe aléatoire
# dans le scénario « mot de passe incorrect ». Laisser vide pour ignorer ce scénario.
GITHUB_TEST_USERNAME=
